          "expected_submission_type": "c_file",
          "is_required": false,
          "execution_args": ["5"],
          "static_rules": {
            "static_rules": {
              "required_calls": ["atoi", "scanf", "printf"],
              "forbidden_calls": ["system"]
            }
          },
          "test_cases": [
            {
              "name": "args_mes_stdin_exact",
              "hidden": false,
              "content": {
                "args": ["7"],
                "input": "10\n",
                "expected": "22\n",
                "mode": "exact"
              }
            },
            {
              "name": "args_negatiu_lines",
              "hidden": true,
              "content": {
                "args": ["-2"],
                "input": "3\n",
                "expected": "6\n",
                "mode": "lines"
              }
            }
          ]
        }
      ]
    },
