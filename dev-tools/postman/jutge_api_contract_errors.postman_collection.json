{
  "info": {
    "_postman_id": "46f63f5a-7691-4d72-9d2a-b3a9bba26400",
    "name": "Jutge API Contract - Error Cases",
    "description": "Negative/edge API contract checks for Jutge.\n\nGoal:\n- Validate key error contracts (400/403/404)\n- Keep PR checks fast and deterministic\n\nRun with Newman:\n  newman run dev-tools/postman/jutge_api_contract_errors.postman_collection.json -e dev-tools/postman/jutge_e2e.local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "professorUsername",
      "value": "profesor_seed"
    },
    {
      "key": "professorPassword",
      "value": "profesor123"
    },
    {
      "key": "professorToken",
      "value": ""
    },
    {
      "key": "errSuffix",
      "value": ""
    },
    {
      "key": "errStudentUsername",
      "value": ""
    },
    {
      "key": "errStudentEmail",
      "value": ""
    },
    {
      "key": "errStudentPassword",
      "value": "student_pass_123"
    },
    {
      "key": "errStudentToken",
      "value": ""
    },
    {
      "key": "errTopicName",
      "value": ""
    },
    {
      "key": "errTopicId",
      "value": ""
    },
    {
      "key": "errQuizId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Bootstrap",
      "item": [
        {
          "name": "0.1 - Professor Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{professorUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{professorPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const professorLoginData = pm.response.json();",
                  "pm.environment.set('professorToken', professorLoginData.access_token);",
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('errSuffix', suffix);",
                  "pm.environment.set('errStudentUsername', `pm_err_${suffix}`);",
                  "pm.environment.set('errStudentEmail', `pm_err_${suffix}@example.com`);",
                  "pm.environment.set('errTopicName', `pm_err_topic_${suffix}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 - Register Error Student",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{errStudentUsername}}\",\n  \"email\": \"{{errStudentEmail}}\",\n  \"password\": \"{{errStudentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 - Login Error Student",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{errStudentUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{errStudentPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('errStudentToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
