    {
      "name": "0. Auth Contract",
      "item": [
        {
          "name": "0.1 - Professor Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{professorUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{professorPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const professorLoginData = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(professorLoginData.access_token).to.be.a('string'));",
                  "pm.environment.set('professorToken', professorLoginData.access_token);",
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('contractSuffix', suffix);",
                  "pm.environment.set('contractStudentUsername', `pm_contract_${suffix}`);",
                  "pm.environment.set('contractStudentEmail', `pm_contract_${suffix}@example.com`);",
                  "pm.environment.set('contractTopicName', `pm_contract_topic_${suffix}`);",
                  "pm.environment.set('contractExerciseTitle', `pm_contract_ex_${suffix}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 - Professor Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{professorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.test('Me has username', () => pm.expect(me.username).to.be.a('string'));",
                  "pm.test('Role is teacher', () => pm.expect(me.role).to.eql('teacher'));"
                ]
              }
            }
          ]
        },
